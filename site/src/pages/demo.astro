---
import { Button, Callout, CodeBlock } from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import { castDemo, castYaml } from '../showcase';

const useCases = [
  {
    id: 'notes-cleanup',
    eyebrow: 'Use Case 1 · Hygiene & Reorganization',
    title: 'Clean up a sprawling Apple Notes library without losing attachments',
    summary:
      'Over years of use, Apple Notes accumulates dozens of single-note folders, empty folders, and duplicate titles. MacFly audits the structure, lets an AI agent or script propose a clean 00–90 taxonomy, protects notes containing tables, checklists, or attachments with its Fidelity Guard, and only executes after you confirm the SHA-256 approval code in an interactive terminal.',
    demo: 'notes-cleanup',
    caption: 'macfly notes audit → plan create → approve → apply',
    docHref: url('docs/guide/cleaning-up-notes/'),
    docLabel: 'Notes cleanup guide',
  },
  {
    id: 'migration',
    eyebrow: 'Use Case 2 · Two-Way Migrations',
    title: 'Migrate between Obsidian, Notion, CSV and Apple Notes & Reminders',
    summary:
      'Move knowledge bases and task lists in either direction without vendor lock-in. Export Apple Notes trees, emails, contacts, calendar events, and open Safari tabs into clean Markdown with YAML frontmatter for Git backups — or import `.md`, `.txt`, `.html`, `.json`, `.jsonl`, and RFC-4180 `.csv` files safely through hash-locked plans.',
    demo: 'migration-import',
    caption: 'macfly notes import · reminders import · notes export',
    docHref: url('docs/guide/migrations/'),
    docLabel: 'Migrations guide',
  },
  {
    id: 'dossier',
    eyebrow: 'Use Case 3 · 360° Cross-App Context',
    title: 'Generate a 360° client dossier and Typst PDF report in seconds',
    summary:
      'Before a client call or review, `macfly context person` correlates matching Contacts, Apple Notes, Apple Mail threads across every configured account, upcoming Calendar meetings, and open Reminders into one DLP-filtered view. Pipe it straight into `macfly report person --output dossier.typ` to compile a clean PDF with Typst or renderreport.',
    demo: 'context-dossier',
    caption: 'macfly context person "Acme" → macfly report person',
    docHref: url('docs/guide/plans-and-workflows/'),
    docLabel: 'Plans & workflows',
  },
  {
    id: 'mail-triage',
    eyebrow: 'Use Case 4 · Privacy-First AI Triage',
    title: 'Triage Apple Mail with a local LLM and a read-side DLP firewall',
    summary:
      'Instead of granting broad cloud OAuth scopes (`Mail.Send`) to third-party SaaS connectors, route reads through MacFly. IBANs, API keys, private keys, and OTPs are automatically redacted in Rust before any model sees them, external emails are tagged `untrusted_external`, signatures stay in Apple Mail as Single Point of Truth, and replies are created as drafts only.',
    demo: 'dlp-mail-triage',
    caption: 'macfly mail search (DLP) → signatures → safe draft plan',
    docHref: url('docs/architecture/security-model/'),
    docLabel: 'Security model & DLP',
  },
  {
    id: 'automation',
    eyebrow: 'Use Case 5 · Daily Routines & Coding Agents',
    title: 'Schedule local briefings with launchd and export an Agent SKILL.md',
    summary:
      'Run `macfly context daily-brief` on a native macOS `launchd` schedule without background daemons or cloud cron jobs, and export a tailored `SKILL.md` (`macfly skill export`) so Claude Code, Codex, Cursor, or Gemini CLI immediately know how to query your macOS apps safely over `macfly mcp`.',
    demo: 'daily-automation',
    caption: 'macfly context daily-brief · schedule add · skill export',
    docHref: url('docs/guide/mcp-and-agents/'),
    docLabel: 'MCP & AI agents',
  },
];
---

<Base
  title="Use Cases"
  description="Real-world MacFly workflows rendered with castwright: Apple Notes cleanup, two-way migrations, 360° client dossiers, DLP mail triage, and local launchd routines."
>
  <div class="page">
    <header class="intro">
      <p class="eyebrow">Real-world workflows · animated with castwright</p>
      <h1>Use Cases</h1>
      <p class="lead">
        Concrete ways teams and solo macOS power users combine MacFly with local LLMs, coding
        agents, Git knowledge bases, and Typst reports. Every terminal scene below is compiled
        declaratively with <code>@casoon/castwright</code> to a zero-script animated SVG with an
        accessible ANSI text fallback.
      </p>
      <nav class="jump" aria-label="Use case sections">
        <ul>
          {
            useCases.map((uc) => (
              <li>
                <a href={`#${uc.id}`}>{uc.eyebrow.split('·')[1]?.trim() ?? uc.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <Callout type="tip">
      Every scene below respects <code>prefers-reduced-motion</code> automatically and includes a
      <strong>Stop animation, show as text</strong> toggle for copy-pasting commands or inspecting
      the full ANSI output.
    </Callout>

    <div class="cases">
      {
        useCases.map((uc) => (
          <section class="case" id={uc.id} aria-labelledby={`${uc.id}-title`}>
            <div class="case-head">
              <p class="case-eyebrow">{uc.eyebrow}</p>
              <h2 id={`${uc.id}-title`}>{uc.title}</h2>
              <p class="case-summary">{uc.summary}</p>
              <div class="case-actions">
                <Button href={uc.docHref} variant="secondary">
                  {uc.docLabel}
                </Button>
                <Button href={url('showcase/')} variant="quiet">
                  View in Showcase →
                </Button>
              </div>
            </div>

            <div class="case-demo">
              <Fragment set:html={castDemo(uc.demo, `uc-${uc.id}`, uc.caption)} />
              <details class="cast-source">
                <summary>
                  castwright source: <code>assets/casts/{uc.demo}.terminal.yaml</code>
                </summary>
                <CodeBlock code={castYaml(uc.demo).trimEnd()} lang="yaml" />
              </details>
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: 36px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 56px 24px 96px;
  }
  .eyebrow,
  .case-eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 38px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .lead {
    max-width: 66ch;
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.65;
  }
  .lead code {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--code-bg);
    font-size: 0.88em;
  }
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jump a {
    display: inline-block;
    padding: 6px 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 13.5px;
    text-decoration: none;
  }
  .jump a:hover,
  .jump a:focus-visible {
    border-color: var(--accent);
    color: var(--heading);
  }
  .cases {
    display: grid;
    gap: 56px;
  }
  .case {
    display: grid;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    scroll-margin-top: 96px;
  }
  .case:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .case h2 {
    margin: 0 0 12px;
    color: var(--heading);
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.25;
  }
  .case-summary {
    max-width: 72ch;
    margin: 0 0 18px;
    font-size: 15.5px;
    line-height: 1.65;
  }
  .case-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .case-demo {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .cast-source summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 13.5px;
  }
  .cast-source[open] summary {
    margin-bottom: 10px;
  }
</style>
