---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  Button,
  CallToAction,
  CodeBlock,
  Compare,
  Facts,
  Features,
  Flow,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
  Tabs,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
import config from 'virtual:casoon-pages/config';
import { castDemo } from '../casts';

type Cell = boolean | string;
const capabilityColumns = [
  { key: 'read', label: 'Read & search' },
  { key: 'export', label: 'Export' },
  { key: 'import', label: 'Import' },
  { key: 'change', label: 'Change via plan' },
  { key: 'auto', label: 'Runs without asking' },
] as const;
const capabilities: { app: string; note: string; cells: Record<(typeof capabilityColumns)[number]['key'], Cell> }[] = [
  { app: 'Notes', note: 'Folders, audit, Fidelity Guard', cells: { read: 'search · audit', export: true, import: '.md .html .json .csv', change: 'create · append · move · folders', auto: 'new notes & folders' } },
  { app: 'Mail', note: 'Every account in Apple Mail', cells: { read: 'DLP-redacted', export: true, import: false, change: 'drafts · mark read · move', auto: 'drafts & mark read' } },
  { app: 'Contacts', note: 'Batched search', cells: { read: 'search · audit', export: true, import: false, change: false, auto: false } },
  { app: 'Calendar', note: 'Upcoming events', cells: { read: 'next N days', export: true, import: false, change: false, auto: false } },
  { app: 'Reminders', note: 'Lists & due dates', cells: { read: 'open · overdue', export: true, import: '.md .json .csv', change: 'create', auto: 'new reminders' } },
  { app: 'Safari', note: 'Open tabs', cells: { read: 'open tabs', export: true, import: false, change: 'tabs → note', auto: 'tabs → note' } },
  { app: 'Photos', note: 'Albums & metadata', cells: { read: 'albums · keywords · dates', export: 'files + XMP/JSON', import: false, change: 'export originals or JPEGs', auto: false } },
  { app: 'Music', note: 'Library & play counters', cells: { read: 'playlists · listening stats', export: 'stats as CSV/JSON', import: false, change: 'create · fill playlists', auto: 'playlist additions' } },
  { app: 'Shortcuts', note: 'Allowlist only', cells: { read: 'list', export: false, import: false, change: 'run allowlisted', auto: false } },
];

const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

const aiPrompts = [
  {
    title: 'Organize my Apple Notes',
    prompt:
      '“Analyze my 800 notes, find duplicates and single-note folders, and propose a cleaner folder structure. Show me every change before applying it.”',
    result:
      'MacFly audits the library, protects notes with tables or attachments via its Fidelity Guard, and builds a reviewable change plan you approve once.',
  },
  {
    title: 'Prepare my daily work',
    prompt:
      '“Check today’s meetings, overdue reminders, and relevant emails across my accounts, and prepare a morning briefing.”',
    result:
      'MacFly correlates 5 Apple apps locally with automatic secret redaction (IBANs, API keys, OTPs) — without cloud OAuth connectors.',
  },
  {
    title: 'Move my knowledge, safely',
    prompt:
      '“Export my project notes as Markdown for my local knowledge base, or import these CSV tasks into Apple Reminders after I review the plan.”',
    result:
      'Markdown export for Notes, Mail, Contacts, Calendar, Reminders and Safari, photo export with metadata, and two-way import for Apple Notes & Reminders (Markdown, HTML, JSON, JSONL, CSV).',
  },
  {
    title: 'Rediscover my music',
    prompt:
      '“Which songs have I played most, and which favorites haven’t I played in ages? Put those into a playlist.”',
    result:
      'MacFly reads the play and skip counters of your Apple Music library, ranks tracks, artists and genres, and builds the playlist through a plan.',
  },
];

const mcpClaudeCode = `# Register MacFly as a local stdio MCP server in Claude Code
claude mcp add macfly -- macfly mcp --profile default

# Optional: export the ready-to-use SKILL.md into your workspace
macfly skill export --output ./.claude/skills/macfly`;

const mcpCodex = `# Register MacFly in OpenAI Codex CLI
codex mcp add macfly -- macfly mcp --profile default

# Or add manually to ~/.codex/config.toml:
# [mcp_servers.macfly]
# command = "macfly"
# args = ["mcp", "--profile", "default"]

# Optional: export SKILL.md for Codex
macfly skill export --output ./.codex/skills/macfly`;

const mcpClaudeDesktop = `// ~/Library/Application Support/Claude/claude_desktop_config.json
{
  "mcpServers": {
    "macfly": {
      "command": "/Users/<you>/.local/bin/macfly",
      "args": ["mcp", "--profile", "default"]
    }
  }
}`;

const mcpCursor = `// .cursor/mcp.json (or ~/.cursor/mcp.json)
{
  "mcpServers": {
    "macfly": {
      "command": "macfly",
      "args": ["mcp", "--profile", "default"]
    }
  }
}`;

const mcpLocalLlm = `# Zero-cloud pipeline with Ollama / MLX on Apple Silicon:
macfly context daily-brief --format agent | ollama run qwen2.5:14b \\
  "Summarize my top 3 priorities today and flag overdue tasks."`;

const quickstartCode = `# 1. Install (no Cargo needed) & verify macOS access
curl -fsSL https://raw.githubusercontent.com/casoon/macfly/main/install.sh | bash
# or: cargo install macfly
macfly doctor
macfly config init   # pick a security preset: strict · balanced · open
macfly policy        # what your AI may do, in plain language

# 2. Connect your AI client (MCP or Agent SKILL.md)
claude mcp add macfly -- macfly mcp --profile default
macfly skill export --output ./.claude/skills/macfly

# 3. Low-risk changes run under your preset — review & approve the rest
macfly plan list
macfly plan inspect <plan-id>
macfly plan approve <plan-id>   # approves and applies`;
---

<Base>
  <!-- 1. AI-first Hero -->
  <Hero
    eyebrow="CASOON open source · Controlled AI Access Layer for macOS"
    title="Let AI work with your Mac. On your terms."
    lead="Give AI agents controlled access to Apple Notes, Mail, Calendar, Contacts, Photos, Music, and more — through a secure, local execution layer. You describe the task. MacFly defines the boundaries, validates changes, and keeps you in control."
  >
    <Install
      commands={[
        { label: 'Installer', command: 'curl -fsSL https://raw.githubusercontent.com/casoon/macfly/main/install.sh | bash' },
        { label: 'Cargo', command: 'cargo install macfly' },
        { label: 'Claude MCP', command: 'claude mcp add macfly -- macfly mcp --profile default' },
      ]}
    />
    <p>
      <strong>Your AI knows what to do. MacFly controls what it can do.</strong>
      No AppleScript or cloud OAuth tokens. Your security preset controls which changes need approval.
    </p>
    <Badges>
      <Badge>AI-first</Badge>
      <Badge>Local-first</Badge>
      <Badge>macOS only</Badge>
      <Badge>Preset-guarded writes</Badge>
      <Badge>Open Source · v{config.version}</Badge>
    </Badges>
    <Fragment
      slot="output"
      set:html={castDemo('hero', 'cw-hero', 'macfly · controlled access across your Apple apps', 'hero-narrow')}
    />
  </Hero>

  <!-- 2. Natural-language AI Use Cases -->
  <section class="prompts" aria-labelledby="prompts-heading">
    <p class="eyebrow">The AI is the interface</p>
    <h2 id="prompts-heading">Just tell your AI what you need</h2>
    <p class="section-lead">
      You do not need to memorize CLI flags or AppleScript. Describe your goal in plain language —
      your AI agent talks to MacFly, and MacFly enforces your rules before touching any app.
    </p>
    <div class="prompt-grid">
      {
        aiPrompts.map((item) => (
          <article class="prompt-card">
            <h3>{item.title}</h3>
            <blockquote>{item.prompt}</blockquote>
            <p>{item.result}</p>
          </article>
        ))
      }
    </div>
    <div class="prompt-links">
      <Button href={url('demo/')} variant="secondary">
        Explore workflows, prompts &amp; configs
      </Button>
      <Button href={url('docs/guide/mcp-and-agents/')} variant="quiet">
        MCP &amp; AI agent guide →
      </Button>
    </div>
  </section>

  <!-- 2b. Capability matrix -->
  <section class="capabilities" aria-labelledby="capabilities-heading">
    <p class="eyebrow">What MacFly does</p>
    <h2 id="capabilities-heading">Nine Apple apps, one controlled layer</h2>
    <p class="section-lead">
      What your AI can do in each app at a glance. Every change goes through a plan; the last
      column shows what the default <code>balanced</code> preset lets through without asking you.
      Mail is never sent, only drafted.
    </p>
    <div class="cap-wrap">
      <table class="cap-table">
        <caption class="sr-only">MacFly capabilities per Apple app</caption>
        <thead>
          <tr>
            <th scope="col">App</th>
            {capabilityColumns.map((c) => <th scope="col">{c.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            capabilities.map((row) => (
              <tr>
                <th scope="row">
                  <span class="cap-app">{row.app}</span>
                  <span class="cap-note">{row.note}</span>
                </th>
                {capabilityColumns.map((c) => {
                  const cell = row.cells[c.key];
                  return (
                    <td data-label={c.label} class={cell ? 'yes' : 'no'}>
                      {cell ? (
                        <span class="cap-cell">
                          <svg class="cap-icon" viewBox="0 0 20 20" aria-hidden="true">
                            <circle cx="10" cy="10" r="9" />
                            <path d="M6 10.5l2.6 2.6L14 7.6" />
                          </svg>
                          <span class="sr-only">Yes</span>
                          {typeof cell === 'string' && <span class="cap-detail">{cell}</span>}
                        </span>
                      ) : (
                        <span class="cap-cell">
                          <span class="cap-dash" aria-hidden="true">—</span>
                          <span class="sr-only">No</span>
                        </span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mac-only">
      <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="3.5" width="15" height="10" rx="1.5" /><path d="M7 16.5h6M10 13.5v3" /></svg>
      <span>
        <strong>macOS only.</strong> MacFly runs on Macs with Apple Silicon or Intel and drives the
        Apple apps through macOS Automation. There is no Windows, Linux or iOS version.
      </span>
    </p>
  </section>

  <!-- 3. Controlled AI Access Layer -->
  <Flow
    eyebrow="Controlled AI Access Layer"
    title="Your AI knows what to do. MacFly controls what it can do."
    lead="MacFly does not automate your Mac for you — it makes your Mac safely usable by AI agents inside a strict, auditable corridor."
    stages={[
      {
        label: '1 · Intent',
        artifact: 'Natural language',
        title: 'You describe the goal',
        body: '“Organize my notes”, “Prepare my 10am meeting”, or “Draft replies to open invoices.”',
      },
      {
        label: '2 · Plan',
        artifact: '25 MCP tools / CLI',
        title: 'Your AI proposes steps',
        body: 'Claude, Codex, Cursor, or Ollama reads DLP-filtered context and submits a typed change plan.',
      },
      {
        label: '3 · Control',
        artifact: 'Preset + diff approval',
        title: 'MacFly checks & asks you',
        body: 'Policy denylists, full-content draft/note diffs and risk levels. Your security preset lets low-risk creates through and asks you for everything else.',
      },
      {
        label: '4 · Execute',
        artifact: 'Lock + journal.jsonl',
        title: 'Deterministic apply',
        body: 'Executed safely across Notes, Mail, Reminders, Safari, Photos, Music & Shortcuts — resumable and logged.',
      },
    ]}
  />

  <!-- 4. Works with your AI -->
  <section class="ai-setup" aria-labelledby="ai-setup-heading">
    <p class="eyebrow">Works with your AI</p>
    <h2 id="ai-setup-heading">Connect Claude, Cursor, Codex, or local models in seconds</h2>
    <p class="section-lead">
      MacFly is model-independent and speaks both modern MCP (up to spec <code>2026-07-28</code>
      with tool annotations) and compact agent-ready CLI JSON. Keep private data 100% local on
      Apple Silicon with Ollama/MLX, or use the built-in DLP firewall with cloud models.
    </p>
    <Tabs
      label="Connect your AI client"
      tabs={[
        { id: 'claude-code', label: 'Claude Code' },
        { id: 'codex', label: 'Codex' },
        { id: 'claude-desktop', label: 'Claude Desktop' },
        { id: 'cursor', label: 'Cursor' },
        { id: 'ollama', label: 'Local Ollama / MLX' },
      ]}
    >
      <div slot="claude-code">
        <CodeBlock code={mcpClaudeCode} lang="sh" title="Claude Code (MCP + SKILL.md)" />
      </div>
      <div slot="codex">
        <CodeBlock code={mcpCodex} lang="sh" title="Codex CLI (MCP + ~/.codex/config.toml)" />
      </div>
      <div slot="claude-desktop">
        <CodeBlock code={mcpClaudeDesktop} lang="json" title="claude_desktop_config.json" />
      </div>
      <div slot="cursor">
        <CodeBlock code={mcpCursor} lang="json" title=".cursor/mcp.json" />
      </div>
      <div slot="ollama">
        <CodeBlock code={mcpLocalLlm} lang="sh" title="100% local Apple Silicon pipeline" />
      </div>
    </Tabs>
  </section>

  <!-- 5. Technical Architecture & Comparison -->
  <Facts
    items={[
      { value: '9 macOS apps', label: 'Notes, Mail, Contacts, Calendar, Reminders, Safari, Photos, Music, and Shortcuts under one typed access layer' },
      { value: '25 MCP tools', label: 'read, 360° context packs, plan creation & apply of approved plans — over MCP, agents can never approve writes' },
      { value: '3 presets', label: 'strict, balanced or open — one choice instead of a rulebook, explained by `macfly policy`' },
      { value: '6 formats', label: 'Markdown export for six apps + two-way import for Notes & Reminders (.md, .txt, .html, .json, .jsonl, .csv)' },
    ]}
  />

  <Features
    heading="Technical architecture under the hood"
    items={[
      {
        title: 'Agents propose, your preset decides',
        body: 'MCP exposes read tools, cross-app context packs, `plan_create` and `plan_apply` for already-approved plans — never `plan_approve`. Which plans run automatically is set by your preset (`strict`, `balanced`, `open`), not by the agent, even under indirect prompt injection.',
      },
      {
        title: 'Read-side Data Firewall (DLP) & profile denylists',
        body: 'Exclude sensitive folders (`Passwords`, `Health`) and mailboxes by policy, redact IBANs, API keys, private keys, card numbers, OTPs and passwords in Rust, and tag external emails as `untrusted_external`.',
      },
      {
        title: 'Full-content diff previews, locks & resume',
        body: 'Inspect complete email draft bodies, line-by-line note additions, and high-risk Shortcut warnings before approving. Exclusive `.lock` files prevent duplicate runs; `partially_applied` plans resume cleanly with `--resume`.',
      },
      {
        title: 'Migrations, backups & photo export',
        body: 'Export Apple Notes trees, emails, contacts, calendar schedules, reminders, and Safari tabs into clean Markdown with YAML frontmatter, and photos as originals or JPEGs with XMP/JSON metadata and a SHA-256 manifest. Import Notes & Reminders from Markdown, HTML, JSON, JSONL, or CSV via reviewable plans.',
      },
      {
        title: 'Pure Rust core, static stdin-only JXA edge',
        body: 'Policy checks, DLP, HTML normalization, Note Fidelity Guard, SHA-256 plan hashing, and JSONL audit logs live in memory-safe Rust — zero Xcode drift, zero `argv` secret leakage, and direct Apple Mail signature lookup.',
      },
      {
        title: '360° dossiers, direct PDF reports & local launchd routines',
        body: 'Correlate Contacts, Notes, Mail, Calendar, and Reminders with `context person`, compile PDF dossiers directly via Typst (`report person --output dossier.pdf`), and schedule local `launchd` briefings.',
      },
    ]}
  />

  <Compare
    title="Next to cloud OAuth connectors"
    lead="Routing AI access through local macOS apps and a Rust policy corridor keeps credentials on-device and puts your approval before every risky write."
    columns={[
      { title: 'Cloud OAuth Connectors', label: 'Direct provider integration' },
      { title: 'MacFly Access Layer', label: 'Local-first on macOS', badge: 'Controlled AI' },
    ]}
    highlight={1}
    rows={[
      {
        topic: 'Mail & app coverage',
        cells: [
          'Usually Gmail or Microsoft 365 only; separate OAuth setup per account.',
          '**Every account in Apple Mail** (iCloud, Gmail, Exchange, custom IMAP) plus Notes, Contacts, Calendar, Reminders, Safari, Photos, Music & Shortcuts.',
        ],
      },
      {
        topic: 'Data residency & privacy',
        cells: [
          'Emails and notes flow through third-party cloud servers.',
          '**100% local on Apple Silicon** with Ollama/MLX; automatic DLP secret redaction and denylists when using cloud models.',
        ],
      },
      {
        topic: 'Write & send safety',
        cells: [
          'Broad OAuth scopes (`Mail.Send`) exposed to indirect prompt injection.',
          '**Drafts only, never sent**, full-content diff preview, security presets with interactive approval for risky changes, and no plan approval over MCP.',
        ],
      },
      {
        topic: 'Migrations & portability',
        cells: [
          'Locked into vendor cloud silos.',
          '**Markdown exports for six apps, photo exports with metadata** plus two-way Markdown/CSV/JSON/HTML migrations for Notes & Reminders.',
        ],
      },
    ]}
    link={{ label: 'Explore real-world use cases & prompts', href: url('demo/') }}
  />

  <!-- 6. Open Source & Getting Started -->
  <Quickstart
    title="Get started in two minutes"
    lead="Install the prebuilt macOS binary (no Rust required) or via crates.io, connect your AI client, and keep every change under your control."
    steps={[
      'Install via the direct shell installer (no Cargo) or <code>cargo install macfly</code>',
      'Verify macOS permissions &amp; create your policy config: <code>macfly doctor</code> · <code>macfly config init</code>',
      'Connect Claude Code, Claude Desktop, Cursor, or Ollama via <code>macfly mcp</code> or <code>macfly skill export</code>',
      'Ask your AI to audit notes, prepare a briefing, or draft replies — low-risk plans run under your preset, the rest you approve in your terminal',
    ]}
  >
    <CodeBlock title="Install, connect AI & approve plans" lang="bash" code={quickstartCode} />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <CallToAction
    title="See what your AI can do across five real macOS workflows."
    href={url('demo/')}
    label="Explore Use Cases & Prompts"
  />
</Base>

<style>
  .prompts,
  .capabilities,
  .ai-setup {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px var(--section-y);
  }
  .eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .prompts h2,
  .capabilities h2,
  .ai-setup h2 {
    max-width: 24ch;
    margin: 0 0 14px;
    color: var(--heading);
    font-size: var(--h-section);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .section-lead {
    max-width: 64ch;
    margin: 0 0 32px;
    font-size: 17.5px;
    line-height: 1.65;
  }
  .section-lead code {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--code-bg);
    font-size: 0.88em;
  }
  .prompt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }
  .prompt-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .prompt-card h3 {
    margin: 0;
    color: var(--heading);
    font-size: 18px;
    font-weight: 600;
  }
  .prompt-card blockquote {
    margin: 0;
    padding: 12px 14px;
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: var(--bg-deep);
    color: var(--heading);
    font-size: 14.5px;
    line-height: 1.55;
  }
  .prompt-card p {
    margin: 0;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .cap-wrap {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .cap-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .cap-table thead th {
    padding: 14px 16px;
    background: var(--bg-deep);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: left;
    text-transform: uppercase;
  }
  .cap-table thead th:last-child,
  .cap-table td:last-child {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .cap-table tbody tr + tr > * {
    border-top: 1px solid var(--border);
  }
  .cap-table tbody th,
  .cap-table td {
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
  }
  .cap-app {
    display: block;
    color: var(--heading);
    font-size: 16px;
    font-weight: 600;
  }
  .cap-note {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 400;
  }
  .cap-cell {
    display: inline-flex;
    align-items: flex-start;
    gap: 8px;
  }
  .cap-icon {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
  }
  .cap-icon circle {
    fill: color-mix(in srgb, var(--accent) 16%, transparent);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .cap-icon path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cap-detail {
    color: var(--heading);
    line-height: 1.45;
  }
  .cap-dash {
    color: var(--muted);
    padding-left: 5px;
  }
  .mac-only {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 72ch;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }
  .mac-only svg {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    fill: none;
    stroke: var(--heading);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .mac-only strong {
    color: var(--heading);
  }
  @media (max-width: 760px) {
    .cap-wrap {
      border: 0;
      background: none;
      box-shadow: none;
      overflow: visible;
    }
    .cap-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .cap-table,
    .cap-table tbody,
    .cap-table tr,
    .cap-table th,
    .cap-table td {
      display: block;
    }
    .cap-table tbody tr {
      margin-bottom: 14px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .cap-table tbody tr + tr > * {
      border-top: 0;
    }
    .cap-table tbody th {
      padding-bottom: 6px;
