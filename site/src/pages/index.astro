---
import {
  Badge,
  Badges,
  Compare,
  Facts,
  Features,
  Flow,
  Hero,
  Install,
  Quickstart,
  Terminal,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import demo from '../macfly-demo.txt?raw';
---

<Base>
  <Hero
    eyebrow="CASOON open source · Rust + AppleScript/JXA"
    title="Safe, deterministic macOS automation."
    lead="MacFly puts a read-side data firewall and SHA-256 plan approval between AI agents and your Apple Notes, Mail, Calendar, Reminders, and Shortcuts — built on a pure Rust core with a thin, stdin-only AppleScript/JXA edge, ready for local LLMs or cloud clients."
  >
    <Badges>
      <Badge>Pure Rust</Badge>
      <Badge>crates.io</Badge>
      <Badge>runemark UI</Badge>
      <Badge>DLP Firewall</Badge>
      <Badge>SHA-256 Plans</Badge>
      <Badge>MCP stdio</Badge>
      <Badge>MIT / Apache-2.0</Badge>
    </Badges>
    <Terminal slot="output" title="macfly doctor & plan create · styled with runemark" dots ansi={demo} />
  </Hero>

  <Install
    commands={[
      { label: 'Cargo', command: 'cargo install macfly' },
      { label: 'Verify', command: 'macfly doctor' },
      { label: 'MCP', command: 'macfly mcp --profile default' },
    ]}
  />

  <Facts
    items={[
      { value: '100% Rust', label: 'deterministic core — policy, DLP, HTML parsing and hashing run offline in cargo test' },
      { value: '0 SDK drift', label: 'no Swift toolchain, no Xcode project, no brittle private framework bindings' },
      { value: 'SHA-256', label: 'canonical plan hash binding with interactive TTY approval and audit journal' },
      { value: 'Read + Plan', label: 'strict MCP boundary — agents may inspect and propose, never approve or apply' },
    ]}
  />

  <Flow
    eyebrow="Safety lifecycle"
    title="No blind writes — every change goes through four steps"
    lead="Whether triggered by a local LLM, an MCP client, or a shell script, mutations are validated, hashed, reviewed, and journaled."
    stages={[
      {
        label: 'Step 1',
        artifact: 'plan.json',
        title: 'Propose',
        body: 'An agent or script submits structured operations via CLI or `plan_create` over MCP.',
      },
      {
        label: 'Step 2',
        artifact: 'sha256 + 0600',
        title: 'Validate & hash',
        body: 'Rust checks scopes, allowlists, and revisions, then locks the plan with a SHA-256 hash and TTL.',
      },
      {
        label: 'Step 3',
        artifact: 'TTY + 6-char code',
        title: 'Approve',
        body: 'You review the `runemark` plan report in an interactive terminal and confirm the hash code.',
      },
      {
        label: 'Step 4',
        artifact: 'journal.jsonl',
        title: 'Apply & audit',
        body: 'MacFly verifies integrity pre-flight, executes losslessly, and appends every result to the audit log.',
      },
    ]}
  />

  <Features
    heading="Why Rust + AppleScript/JXA — and why security comes first"
    items={[
      {
        title: 'Deterministic core, thin macOS edge',
        body: 'Policy evaluation, DLP redaction, HTML normalization, note fidelity checks, SHA-256 plan hashing, and the audit journal live in pure, memory-safe Rust. macOS interaction stays isolated in static stdin-only JXA scripts and official CLI bridges.',
      },
      {
        title: 'Read-side Data Firewall (DLP) & Local AI ready',
        body: 'Pair MacFly with local LLMs (Ollama, LM Studio, MLX) so private data never leaves your Mac. When using cloud models, profile denylists, automatic regex redaction (IBAN, API keys, OTPs), and untrusted_external mail framing protect every read.',
      },
      {
        title: 'Fidelity guard for Apple Notes',
        body: 'Naive script writes silently wipe attachments, tables, checklists, and applenotes:// links. MacFly inspects note fidelity first, blocks destructive body replacement on rich notes, and moves notes and whole folder trees losslessly.',
      },
      {
        title: 'Allowlist-gated Apple Shortcuts',
        body: 'Trigger Focus modes, HomeKit scenes, or modern App Intents via `shortcuts run` without fragile UI scripting. Nothing runs unless explicitly listed in `shortcuts.allow` and approved through a plan.',
      },
      {
        title: 'Single Point of Truth for Apple Mail',
        body: 'No duplicate IMAP passwords and no second copy of your email footer. MacFly uses your existing Apple Mail accounts, pulls signatures straight from Apple Mail, and creates drafts for human review.',
      },
      {
        title: 'Consistent terminal UX powered by runemark',
        body: 'Human-readable output uses `runemark` for semantic verdicts, grouped findings, actionable error blocks, and NO_COLOR compliance — while `--format json` and `--format agent` stay pure machine-readable JSON.',
      },
    ]}
  />

  <Compare
    columns={[
      { title: 'Cloud OAuth Connectors', label: 'Direct provider integration' },
      { title: 'MacFly + Local AI', label: 'Local-first on macOS', badge: 'Privacy-first' },
    ]}
    highlight={1}
    rows={[
      {
        topic: 'Mail providers',
        cells: [
          'Usually Gmail or Microsoft 365 only; separate OAuth setup per account.',
          '**Every account in Apple Mail** — iCloud, Gmail, Exchange, and any custom IMAP server.',
        ],
      },
      {
        topic: 'Data residency',
        cells: [
          'Emails and notes are transmitted to cloud AI servers.',
          '**100% local on Apple Silicon** with Ollama/MLX; DLP firewall when using cloud models.',
        ],
      },
      {
        topic: 'Write & send safety',
        cells: [
          'Broad OAuth scopes (`Mail.Send`) exposed to indirect prompt injection.',
          '**Drafts by default**, SHA-256 plan approval in interactive TTY, MCP read + plan-only.',
        ],
      },
      {
        topic: 'Signatures & footers',
        cells: [
          'Must be duplicated in prompts or connector configs.',
          '**Single Point of Truth** — pulled directly from Apple Mail.',
        ],
      },
    ]}
  />

  <Quickstart
    title="Get started in two minutes"
    lead="Install from crates.io, verify macOS permissions, and inspect your Notes, Mail, Calendar, Reminders, and Shortcuts."
    steps={[
      'Install: cargo install macfly',
      'Check macOS access: macfly doctor',
      'Create central config: macfly config init (~/.config/macfly/config.json)',
      'Audit & inspect: macfly notes audit · macfly mail overview · macfly shortcuts list · macfly context daily-brief',
      'Connect an MCP client: point stdio to `macfly mcp --profile default`',
    ]}
  />
</Base>
