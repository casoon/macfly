---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  CallToAction,
  CodeBlock,
  Compare,
  Facts,
  Features,
  Flow,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
import config from 'virtual:casoon-pages/config';
import { castDemo } from '../casts';

const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

const quickstartCode = `# 1. Install (no Cargo needed) & verify macOS access
curl -fsSL https://raw.githubusercontent.com/casoon/macfly/main/install.sh | bash
# or: cargo install macfly
macfly doctor
macfly config init

# 2. Audit & reorganize Notes, Mail, Contacts, Calendar, Reminders & Safari
macfly notes audit
macfly contacts audit
macfly mail overview
macfly safari tabs
macfly context daily-brief

# 3. Migrate & back up (Markdown, CSV, JSON, JSONL, HTML)
macfly notes export --output ./notes-backup --folder "10 · Work"
macfly notes import --input ./notion-or-evernote --folder "00 · Inbox" --recursive
macfly mail export --output ./mail-archive --query "Invoice"

# 4. Cross-app 360° dossiers, Typst reports, SKILL.md & launchd schedules
macfly context person "Acme"
macfly context meeting-prep --query "Kickoff" --create-note
macfly report person "Acme" --output ./dossier-acme.pdf
macfly skill export --output ./.claude/skills/macfly`;
---

<Base>
  <Hero
    eyebrow="CASOON open source · Rust + AppleScript/JXA"
    title="Safe, deterministic macOS automation & migration."
    lead="MacFly puts a read-side DLP firewall, SHA-256 plan approval, and two-way migration pipelines between AI agents (or Git knowledge bases) and your Apple Notes, Mail, Contacts, Calendar, Reminders, Safari, and Shortcuts."
  >
    <Install
      commands={[
        { label: 'Installer', command: 'curl -fsSL https://raw.githubusercontent.com/casoon/macfly/main/install.sh | bash' },
        { label: 'Cargo', command: 'cargo install macfly' },
        { label: 'Verify', command: 'macfly doctor' },
      ]}
    />
    <p>
      100% local on macOS — works with Ollama/MLX, Claude Code, Codex, and Cursor over stdio MCP
      without cloud OAuth tokens or unattended writes.
    </p>
    <Badges>
      <Badge>Pure Rust</Badge>
      <Badge>v{config.version}</Badge>
      <Badge>MCP stdio</Badge>
      <Badge>MIT / Apache-2.0</Badge>
    </Badges>
    <Fragment
      slot="output"
      set:html={castDemo('hero', 'cw-hero', 'macfly · doctor, notes audit & 360° dossier', 'hero-narrow')}
    />
  </Hero>

  <Facts
    items={[
      { value: '7 macOS apps', label: 'Notes, Mail, Contacts, Calendar, Reminders, Safari, and Shortcuts under one typed CLI & MCP' },
      { value: '6 formats', label: 'two-way migrations across Markdown, Plaintext, HTML, JSON, JSONL, and RFC-4180 CSV' },
      { value: 'SHA-256', label: 'canonical plan hash binding with interactive TTY approval and JSONL audit journal' },
      { value: '0 SDK drift', label: '100% Rust core + stdin-only JXA — no Swift toolchain, no Xcode project, no private DB hacks' },
    ]}
  />

  <Flow
    eyebrow="Safety & migration lifecycle"
    title="No blind writes — every change and import goes through four steps"
    lead="Whether triggered by a multi-format migration, a local LLM, an MCP client, or a shell script, mutations are validated, hashed, reviewed, and journaled."
    stages={[
      {
        label: 'Step 1',
        artifact: 'plan.json / import',
        title: 'Propose or import',
        body: 'An agent proposes operations over MCP, or `notes/reminders import` parses `.md`, `.csv`, `.json`, `.html` files.',
      },
      {
        label: 'Step 2',
        artifact: 'sha256 + 0600',
        title: 'Validate & hash',
        body: 'Rust checks scopes, allowlists, and revisions, then locks the plan with a SHA-256 hash and TTL.',
      },
      {
        label: 'Step 3',
        artifact: 'TTY + 6-char code',
        title: 'Approve',
        body: 'You review the `runemark` plan report in an interactive terminal and confirm the hash code.',
      },
      {
        label: 'Step 4',
        artifact: 'journal.jsonl',
        title: 'Apply & audit',
        body: 'MacFly verifies integrity pre-flight, executes losslessly, and appends every result to the audit log.',
      },
    ]}
  />

  <Features
    heading="Why Rust + AppleScript/JXA — for AI agents and migrations alike"
    items={[
      {
        title: 'Two-way migrations (Apple ⇄ Markdown, CSV, JSON, HTML)',
        body: 'Export Apple Notes trees, project emails, contacts, reminders, calendar schedules, and open Safari tabs into clean Markdown files with YAML frontmatter. Import notes and tasks from Markdown, HTML, JSON, JSONL, or CSV (Notion, Evernote, Obsidian, Todoist) safely through hashed plans.',
      },
      {
        title: 'Deterministic core, thin macOS edge',
        body: 'Policy evaluation, DLP redaction, HTML normalization, multi-format import parsers, note fidelity checks, SHA-256 plan hashing, and the audit journal live in pure, memory-safe Rust — tested offline in milliseconds with `cargo test` and immune to yearly macOS SDK drift.',
      },
      {
        title: 'Read-side Data Firewall (DLP) & Local AI ready',
        body: 'Pair MacFly with local LLMs (Ollama, LM Studio, MLX) so private data never leaves your Mac. When using cloud models, profile denylists, automatic regex redaction (IBAN, API keys, OTPs), and untrusted_external mail framing protect every read.',
      },
      {
        title: 'Fidelity guard & cleanup audits',
        body: '`notes audit` and `contacts audit` uncover empty folders, single-note folders, duplicate titles, and duplicate contacts. When reorganizing Apple Notes, MacFly protects attachments, tables, checklists, and applenotes:// links from destructive edits.',
      },
      {
        title: 'Single Point of Truth for Mail, Safari & Shortcuts',
        body: 'No duplicate IMAP passwords and no second copy of your email footer — signatures are pulled straight from Apple Mail. Capture open Safari research tabs directly into Apple Notes, and trigger allowlisted Shortcuts for Focus modes or HomeKit scenes.',
      },
      {
        title: 'Consistent terminal UX powered by runemark',
        body: 'Human-readable output uses `runemark` for semantic verdicts, grouped findings, actionable error blocks, and NO_COLOR compliance — while `--format json`, `--format agent`, and `macfly mcp` deliver pure machine-readable JSON.',
      },
    ]}
  />

  <Compare
    title="Next to cloud OAuth connectors"
    lead="Routing macOS automation through local apps and a Rust data firewall keeps credentials on-device and unlocks two-way migrations across every account."
    columns={[
      { title: 'Cloud OAuth Connectors', label: 'Direct provider integration' },
      { title: 'MacFly + Local AI', label: 'Local-first on macOS', badge: 'Privacy-first' },
    ]}
    highlight={1}
    rows={[
      {
        topic: 'Mail & app coverage',
        cells: [
          'Usually Gmail or Microsoft 365 only; separate OAuth setup per account.',
          '**Every account in Apple Mail** (iCloud, Gmail, Exchange, custom IMAP) plus Notes, Contacts, Calendar, Reminders, Safari & Shortcuts.',
        ],
      },
      {
        topic: 'Migrations & backups',
        cells: [
          'Locked into vendor cloud silos.',
          '**Two-way Markdown/CSV/JSON/HTML pipelines** for Git knowledge bases, Obsidian, Notion, and local archives.',
        ],
      },
      {
        topic: 'Data residency',
        cells: [
          'Emails and notes are transmitted to cloud AI servers.',
          '**100% local on Apple Silicon** with Ollama/MLX; DLP firewall when using cloud models.',
        ],
      },
      {
        topic: 'Write & send safety',
        cells: [
          'Broad OAuth scopes (`Mail.Send`) exposed to indirect prompt injection.',
          '**Drafts by default**, SHA-256 plan approval in interactive TTY, MCP read + plan-only.',
        ],
      },
    ]}
    link={{ label: 'Explore real-world use cases', href: url('demo/') }}
  />

  <Quickstart
    title="Get started in two minutes"
    lead="Install the prebuilt macOS binary (no Rust required) or via crates.io, verify macOS permissions, and audit, automate, or migrate your Apple apps."
    steps={[
      'Install via the direct shell installer (no Cargo) or <code>cargo install macfly</code>',
      'Check macOS access &amp; create config: <code>macfly doctor</code> · <code>macfly config init</code>',
      'Audit &amp; clean up: <code>macfly notes audit</code> · <code>macfly contacts audit</code>',
      'Export or import: <code>macfly notes export --output ./backup</code> · <code>macfly notes import --input ./docs --folder "00 · Inbox" --recursive</code>',
      'Connect an MCP client: point stdio to <code>macfly mcp --profile default</code>',
    ]}
  >
    <CodeBlock title="Terminal, migrations & MCP setup" lang="bash" code={quickstartCode} />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <CallToAction
    title="See MacFly across five real-world macOS workflows."
    href={url('demo/')}
    label="Explore Use Cases"
  />
</Base>
